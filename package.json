{
  "name": "wordwright",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @wordwright/api --filter @wordwright/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "pnpm --filter @wordwright/web test:e2e",
    "e2e:titles": "pnpm --silent --filter @wordwright/web e2e:titles",
    "coverage": "pnpm -r --workspace-concurrency=1 coverage",
    "eval": "pnpm --filter @wordwright/evals eval",
    "eval:targets": "pnpm --filter @wordwright/evals eval:targets",
    "eval:adapter": "pnpm --filter @wordwright/evals eval:adapter",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:licences": "node scripts/check-licences.mjs",
    "check:node-pins": "node scripts/check-node-pins.mjs",
    "knip": "knip",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "knip": "^6.43.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vue-eslint-parser": "^10.4.1"
  }
}
