# Caddy gets the HTTPS certificate for SITE_ADDRESS by itself (so ports 80 and 443 must reach it).
# For a trial on your own machine set SITE_ADDRESS=localhost: Caddy then makes its own, untrusted certificate.
{$SITE_ADDRESS:localhost} {
	header {
		# One week while we are starting out; raise it (and only then think about preload) once it has held for a while.
		Strict-Transport-Security "max-age=604800"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Only our own files run (#317), so text that slips past escaping still can't run a script or send data away.
		# The hash is the theme script inline in apps/web/index.html: change that and change this (a test checks).
		# Styles allow inline because the editor sets them. `?`: an API response that has its own policy keeps it.
		?Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-P9+7wJNW16jB3pOhoC+ZxMGfrcq1cSdjLv0uYNpaKQg='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# The API streams the AI's replies as they are written, so nothing here may hold them back.
	handle /api/* {
		# A backstop; the API refuses anything over its own, smaller limit with a message.
		request_body {
			max_size 8MB
		}
		reverse_proxy api:8787 {
			flush_interval -1
		}
	}

	# For uptime monitors. /ready is for the containers themselves and is not published.
	handle /health {
		reverse_proxy api:8787
	}

	# Without this, the catch-all below would answer /ready with the web app's page and a 200.
	handle /ready {
		respond 404
	}

	handle {
		encode zstd gzip
		root * /srv
		# Built files carry a hash in their name, so they never change.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Every other address belongs to the web app's own router.
		try_files {path} /index.html
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		file_server
	}
}
