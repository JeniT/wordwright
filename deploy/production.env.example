# Copy to `.env` in this folder on the server (never commit it: `.env` is ignored) and fill it in.
# Generate each secret with:  openssl rand -base64 48
# Keep a copy of KEY_ENCRYPTION_SECRET somewhere apart from the data backups: without it every stored AI key
# is unreadable and writers must enter theirs again.

# The address people use, without https:// (Caddy gets its certificate for this name), and the same with it.
SITE_ADDRESS=app.wordwright.io
PUBLIC_URL=https://app.wordwright.io

NODE_ENV=production
SESSION_SECRET=
KEY_ENCRYPTION_SECRET=

# Email through Scaleway Transactional Email (see docs/deploy.md). The SMTP address contains a credential.
MAIL_TRANSPORT=smtp
MAIL_FROM=Wordwright <hello@wordwright.io>
SMTP_URL=

# The private alpha (#328): new accounts wait until an admin approves them. "required" is the default; "open" lets
# everyone in. ADMIN_EMAILS (comma-separated) become admins once they have confirmed their email. Admin can also be
# given later with the command in docs/deploy.md.
ACCOUNT_APPROVAL=required
# Sign-ups allowed an hour across the whole site.
SIGNUPS_PER_HOUR=30
ADMIN_EMAILS=

# Google sign-in: leave both empty until it is set up (#350).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Which build to run (a commit hash from the image workflow, or `latest`).
WORDWRIGHT_TAG=latest
