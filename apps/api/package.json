{
  "name": "@wordwright/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "start": "tsx src/server.ts",
    "admin": "tsx src/admin-cli.ts",
    "replay-deletions": "tsx src/replay-deletions-cli.ts",
    "forget-kept-name": "tsx src/forget-kept-name-cli.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include='src/**' --coverage.exclude='**/*.test.ts' --coverage.reporter=text-summary --coverage.reporter=html"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@wordwright/core": "workspace:*",
    "@wordwright/prompts": "workspace:*",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "nodemailer": "^10.2.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "mailparser": "^3.12.4",
    "smtp-server": "^3.21.1",
    "vitest": "^5.0.5"
  }
}
