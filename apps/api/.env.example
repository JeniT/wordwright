PORT=8787
# Origin the web app is served from (reset links, OAuth redirects, CSRF check).
PUBLIC_URL=http://localhost:5173
# Required in production: 32+ random characters (e.g. `openssl rand -base64 32`).
SESSION_SECRET=
DATABASE_PATH=./data/lfwa.sqlite

# Providers: "fake" or "anthropic"
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# "Log in with Google" (optional). Redirect URI to register with Google:
#   ${PUBLIC_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
