PORT=8787
# Origin the web app is served from (reset links, OAuth redirects, CSRF check).
PUBLIC_URL=http://localhost:5173
# Required in production: 32+ random characters each (e.g. `openssl rand -base64 32`).
SESSION_SECRET=
# Encrypts users' stored API keys. Back it up: if it's lost, every stored key is unreadable.
KEY_ENCRYPTION_SECRET=
DATABASE_PATH=./data/wordwright.sqlite

# How emails (password resets) are delivered:
#   console (default): print them to the server log; no provider needed for local development
#   file:              write each to MAIL_OUTBOX_DIR as JSON (used by the e2e tests)
#   smtp:              really send via SMTP_URL (required in production)
MAIL_TRANSPORT=console
MAIL_FROM="Wordwright <no-reply@example.com>"
# e.g. smtps://user:password@smtp.example.com:465, or smtp://localhost:1025 for Mailpit. Contains credentials.
SMTP_URL=
MAIL_OUTBOX_DIR=./data/outbox

# Development only: skip real LLM calls and accept any API key.
FAKE_LLM=false
# Pretend every *.example address is a feed instead of reading the internet (development and e2e only).
FAKE_FEEDS=false

# How the titles of pages linked from an idea are looked up:
#   http (default): fetch them from the web, only ever from public sites
#   fake:           canned titles, no network (development and e2e tests only)
PAGE_FETCHER=http

# Delete accounts that never confirmed their email and were never used (no drafts, no saved API key)
# after this many days, freeing the address. 0 keeps them forever.
UNCONFIRMED_ACCOUNT_TTL_DAYS=14

# Private alpha: "required" (default) makes every new account wait for the owner to approve it; "open" lets everyone in
# at once (handy for local development). Admins are set only here or with `pnpm --filter @wordwright/api admin grant <email>`.
ACCOUNT_APPROVAL=required
# Sign-ups allowed an hour across the whole site (each one sends an email).
SIGNUPS_PER_HOUR=30
# Comma-separated addresses that become admins once confirmed. The first also gets an Admin account at server start (no
# password: set one with "Forgot password"), so it must be a real inbox.
ADMIN_EMAILS=admin@wordwright.io

# "Log in with Google" (optional). Redirect URI to register with Google:
#   ${PUBLIC_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
